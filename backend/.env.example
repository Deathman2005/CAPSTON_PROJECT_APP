# SMS Shield Backend Configuration Example
# Copy to .env and adjust values for your environment

ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="SMS Shield AI Backend"
VERSION="0.1.0"
API_V1_STR=/api/v1

# Database Configuration
# Local SQLite default (zero configuration required):
DATABASE_URL=sqlite+aiosqlite:///./sms_shield.db
# PostgreSQL (Docker Compose / Production):
# DATABASE_URL=postgresql+psycopg://smsshield:smsshield_dev_secret_change_in_prod@localhost:5432/smsshield

# Security & CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Threat Intelligence Provider API Keys (Leave blank if not yet configured)
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=

# Groq AI Explanation Configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=6.0
